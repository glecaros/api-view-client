{
  "name": "@api-view/typespec",
  "version": "1.0.0",
  "description": "TypeSpec definition for APIView Service",
  "private": true,
  "scripts": {
    "generate:typescript": "tsp compile . --emit @azure-tools/typespec-ts && mkdir -p ../packages && mv tsp-output/@azure-tools/typespec-ts ../packages/typescript-client",
    "clean": "rimraf tsp-output ../packages/typescript-client"
  },
  "dependencies": {
    "@azure-tools/typespec-azure-core": "~0.62.0",
    "@azure-tools/typespec-client-generator-core": "~0.62.0",
    "@azure-tools/typespec-ts": "^0.47.0",
    "@typespec/compiler": "^1.7.0",
    "@typespec/events": "~0.76.0",
    "@typespec/http": "^1.7.0",
    "@typespec/openapi": "^1.7.0",
    "@typespec/rest": "~0.76.0",
    "@typespec/sse": "~0.76.0",
    "@typespec/streams": "~0.76.0",
    "@typespec/versioning": "~0.76.0",
    "@typespec/xml": "~0.76.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.5"
  }
}
