{
  "name": "api-view-client",
  "version": "1.0.0",
  "private": true,
  "description": "APIView client libraries generated from TypeSpec",
  "workspaces": [
    "typespec",
    "packages/*"
  ],
  "scripts": {
    "generate": "yarn workspace @api-view/typespec generate",
    "generate:typescript": "yarn workspace @api-view/typespec generate:typescript",
    "build": "yarn workspaces foreach -A run build",
    "clean": "yarn workspaces foreach -A run clean"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/glecaros/api-view-client.git"
  },
  "keywords": [
    "apiview",
    "typespec",
    "client",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "yarn@4.0.2"
}
